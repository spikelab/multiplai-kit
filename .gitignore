.env
env.*
!env.example
.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Legacy machine-local settings overlay. Claude Code does NOT read this at user
# scope — setup.sh writes plugin options into the tracked dotfiles/settings.json
# and moves any leftover copy of this file to .unused (kit #34). Ignored so a
# pre-existing one, and the .unused rename, never dirty the tree.
dotfiles/settings.local.json
dotfiles/settings.local.json.unused

# Claude Code runtime state (created when running)
dotfiles/.workspace
dotfiles/.credentials.json
dotfiles/.claude.json
dotfiles/.claude.json.backup
dotfiles/mcp-needs-auth-cache.json
dotfiles/memory
# no trailing slash: on some machines these are symlinks into cc-state, and
# `dir/` patterns do not match symlinks
dotfiles/projects
dotfiles/sessions/
dotfiles/backups/
dotfiles/statsig/
dotfiles/logs/

# Kit runtime state (hook-managed, not dotfiles)
runtime/
dotfiles/cache/
dotfiles/debug/
dotfiles/plugins/
dotfiles/shell-snapshots/
dotfiles/telemetry/
dotfiles/todos
dotfiles/.timezone
dotfiles/history.jsonl
dotfiles/memory-error.log
dotfiles/file-history/
dotfiles/paste-cache/
dotfiles/stats-cache.json
dotfiles/tasks/
dotfiles/plans/
# Agent-supervisor daemon + job runtime state (leaks PIDs/sessionIds/paths/PII — never ship)
dotfiles/daemon.lock
dotfiles/daemon.log
dotfiles/daemon.status.json
dotfiles/daemon/
dotfiles/jobs/
dotfiles/.last-update-result.json
# Legacy (kept for backward compat during transition)
dotfiles/hook-sessions/
dotfiles/session-env/

# Container
container/.env

# Workspace artifacts (shouldn't be in kit root)
.captainslog/
.learnings/
.multiplai/
captainslog/

.last-cleanup

# Local-only skills authored under dotfiles/skills/ are per-user; ignore any
# that a given machine adds beyond the shipped README.
dotfiles/skills/*
!dotfiles/skills/README.md

# BuildMe/OpenSpec change proposals (per-project working state, not shipped)
specs/

# Container tooling — fetched from spikelab/multiplai-container by setup.sh
container/
