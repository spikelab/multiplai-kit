# multiplai-kit — PROFILE OVERRIDE TEMPLATE
# Copy to env.<name> (e.g., env.work, env.personal):  cp env.example env.work
# Use with: ./claude.sh --profile <name>
#
# Profile files override git identity + GH token ONLY. The rest of the config
# (workspace, API keys, container settings) still comes from .env.
#
# NOT TO BE CONFUSED WITH .env.example (with a dot), which is the template for
# the base config file .env. See README.md → "Environment Configuration".

GIT_AUTHOR_NAME="Your Name"
GIT_AUTHOR_EMAIL="you@company.com"
GIT_COMMITTER_NAME="Your Name"
GIT_COMMITTER_EMAIL="you@company.com"

# macOS Keychain key for GitHub token (different per org)
GH_TOKEN_KEYCHAIN="gh-token-myorg"

# Claude credentials file — separate per profile for different Claude accounts.
# Each profile gets its own OAuth credentials, so you can use a personal
# subscription for personal work and a Teams/Enterprise account for work.
# Use an absolute path, NOT $HOME (same convention as WORKSPACE in .env).
# CLAUDE_CREDENTIALS_FILE="/Users/youruser/.claude-container/credentials-myorg.json"

# Gemini CLI credentials directory — separate per profile for different Google accounts.
# Use an absolute path, NOT $HOME.
# GEMINI_CONFIG_DIR="/Users/youruser/.gemini-work"
