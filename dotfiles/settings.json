{
  "cleanupPeriodDays": 365,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "30000",
    "BASH_MAX_OUTPUT_LENGTH": "150000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "100000",
    "DISABLE_AUTO_COMPACT": "1"
  },
  "autoCompactEnabled": false,
  "permissions": {
    "deny": [
      "Skill(deep-research)"
    ],
    "allowedTools": [
      "Read",
      "Bash(git *)",
      "Bash(gh *)",
      "WebSearch"
    ]
  },
  "model": "claude-opus-5[1m]",
  "skillOverrides": {
    "deep-research": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p $CLAUDE_MULTIPLAI_HOME/runtime/logs 2>/dev/null; bash $CLAUDE_CONFIG_DIR/hooks/gh-app-auth.sh 2>>$CLAUDE_MULTIPLAI_HOME/runtime/logs/hook-errors.log || true",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "mkdir -p $CLAUDE_MULTIPLAI_HOME/runtime/logs 2>/dev/null; gh auth setup-git 2>>$CLAUDE_MULTIPLAI_HOME/runtime/logs/hook-errors.log || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_CONFIG_DIR/hooks/guard-destructive.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "mkdir -p $CLAUDE_MULTIPLAI_HOME/runtime/logs 2>/dev/null; bash $CLAUDE_CONFIG_DIR/hooks/gh-app-refresh.sh 2>>$CLAUDE_MULTIPLAI_HOME/runtime/logs/hook-errors.log || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p $CLAUDE_MULTIPLAI_HOME/runtime/logs 2>/dev/null; bash $CLAUDE_CONFIG_DIR/hooks/validate-syntax.sh 2>>$CLAUDE_MULTIPLAI_HOME/runtime/logs/hook-errors.log"
          }
        ]
      }
    ]
  },
  "disableAllHooks": false,
  "statusLine": {
    "type": "command",
    "command": "bash $CLAUDE_CONFIG_DIR/scripts/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "multiplai-context@multiplai": true,
    "multiplai-dev@multiplai": true,
    "multiplai-media@multiplai": true,
    "multiplai-messaging@multiplai": true,
    "multiplai-pm@multiplai": true,
    "multiplai-research@multiplai": true,
    "multiplai-writing@multiplai": true
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "pluginConfigs": {
    "multiplai-context@multiplai": {
      "options": {
        "workspace_dir": "",
        "enable_skills": true,
        "skills_dir": "",
        "enable_resources": false,
        "resources_dir": "",
        "enable_costs": true,
        "memory_router": "token_overlap",
        "router_model": "claude-haiku-4-5",
        "checkpoint_timeout_s": "480",
        "checkpoint_hard_stop_tokens": "250000"
      }
    }
  },
  "tui": "default",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
