#!/bin/bash
# fleet-watch — the fleet board in a spare terminal, for people who would rather
# keep their status bar. Same board as `fleet-bar`, redrawn on a timer, sized to
# the whole window instead of three status lines.
#
#   dotfiles/scripts/fleet-watch        # redraw every 5s
#   dotfiles/scripts/fleet-watch 2      # every 2s
#
# Any key quits. Redirected or piped, it prints the board once and exits, so
# `fleet-watch > board.txt` is a snapshot rather than a hung process.
#
# It reuses `fleet-bar-render.py` unchanged, so it inherits that renderer's
# fixed column budget — checkpoint text is still clipped at 44 characters, and
# there is no scrolling: it fills the window and says `+N more` for the rest.
# What it buys over the status bar is height, and every window back.
#
# Host-safe by construction, for the same reason `fleet-bar` is: the renderer is
# stdlib-only and reads data files. Nothing here resolves or executes plugin
# code. See docs/TMUX-FLEET-BOARD.md.
#
# Unlike the other two host-side scripts this one is interactive, so it *does*
# print its failures — a person ran it and is looking at the output.

interval="${1:-5}"
case "$interval" in ''|*[!0-9]*) interval=5 ;; esac

scripts="$(dirname "$0")"
renderer="$scripts/fleet-bar-render.py"

if [ ! -r "$renderer" ]; then
    echo "fleet-watch: no fleet-bar-render.py beside $scripts" >&2
    exit 1
fi

# Same resolution order as fleet-bar: the environment, then the marker setup.sh
# writes one directory above the scripts.
ws="${WORKSPACE:-}"
if [ -z "$ws" ] && [ -r "$scripts/../.workspace" ]; then
    read -r ws < "$scripts/../.workspace"
fi
if [ -z "$ws" ]; then
    echo "fleet-watch: cannot resolve the workspace — run setup.sh, or set WORKSPACE" >&2
    exit 1
fi

command -v python3 >/dev/null 2>&1 || {
    echo "fleet-watch: python3 not found" >&2
    exit 1
}

draw() {
    rows=$(tput lines 2>/dev/null); cols=$(tput cols 2>/dev/null)
    case "$rows" in ''|*[!0-9]*) rows=24 ;; esac
    case "$cols" in ''|*[!0-9]*) cols=120 ;; esac

    python3 "$renderer" --data-dir "$ws/.multiplai/data" \
        --lines "$((rows - 1))" --width "$cols" 2>&1
}

# Not a terminal — a pipe, a redirect, a test harness. Print the board once and
# leave. Clearing the screen and waiting on a keypress needs a tty for both
# halves, and without one the wait returns instantly, which is a busy loop
# redrawing forever rather than a board.
if [ ! -t 1 ] || [ ! -r /dev/tty ]; then
    draw
    exit 0
fi

trap 'printf "\033[?25h\n"; exit 0' INT TERM
printf '\033[?25l'   # hide the cursor; the trap puts it back

while :; do
    board=$(draw)
    printf '\033[H\033[2J%s' "$board"   # home, clear, draw
    read -r -t "$interval" _ </dev/tty && break
done

printf '\033[?25h\n'
