#!/bin/bash
# fleet-watch — the fleet board, in a terminal you keep on screen.
#
#   dotfiles/scripts/fleet-watch        # redraw every 5s
#   dotfiles/scripts/fleet-watch 2      # every 2s
#
# Any key quits — a single keystroke, not a line, which is why the wait is
# `read -n 1` and not a bare `read`. Redirected or piped, it prints the board
# once and exits, so `fleet-watch > board.txt` is a snapshot rather than a hung
# process.
#
# It renders through `fleet-render.py`, which now spends the whole window: the
# checkpoint text takes whatever the fixed fields leave. What remains of its
# status-bar ancestry is that it does not scroll — overflow is still `+N more`,
# and the fleet console is what lifts that.
#
# Before each redraw it also refreshes the tmux pane map through
# `fleet-panes.sh`. That is what makes tab labels track reality at the board's
# own resolution rather than at launch resolution: rename a tab and the next
# frame has the new name, and a container that was already running when the
# board started acquires a row label instead of being stuck with its container
# name forever. The renderer is not involved and must not be — it is pinned
# stdlib-only *and* subprocess-free, so the tmux call lives here.
#
# Host-safe by construction: the renderer is stdlib-only and reads data files.
# Nothing here resolves or executes plugin code — the plugin's manifest and
# cache are container-writable. See docs/TMUX-FLEET-BOARD.md.
#
# Unlike `fleet-viewed.sh`, which is a tmux hook and silent by contract, this
# one *prints* its failures — a person ran it and is looking at the output.

# `0` is rejected along with the junk, and is the only interesting one: it
# survives a digits-only test but `read -t 0` does not wait. Bash returns
# immediately, non-zero unless a keystroke is already buffered — so the loop
# never breaks and never pauses, and the board becomes a full-speed redraw
# forking `tput` twice and `python3` once per iteration. Measured at 478
# redraws per second against a do-nothing renderer.
interval="${1:-5}"
case "$interval" in ''|0|*[!0-9]*) interval=5 ;; esac

scripts="$(dirname "$0")"
renderer="$scripts/fleet-render.py"
panes="$scripts/fleet-panes.sh"

if [ ! -r "$renderer" ]; then
    echo "fleet-watch: no fleet-render.py beside $scripts" >&2
    exit 1
fi

# Same resolution chain as the fleet scripts and the statusline
# (lib/resolve-workspace.sh sets `ws`), rather than the subset this used to
# keep. A terminal has neither `$WORKSPACE` nor `$CLAUDE_CONFIG_DIR`, so the
# marker rungs in the library are what answer here. Unlike the other callers
# an unresolved workspace is fatal, and says so.
ws="${WORKSPACE:-}"
if [ -z "$ws" ]; then
    _ws_lib="$scripts/lib/resolve-workspace.sh"
    [ -r "$_ws_lib" ] && . "$_ws_lib"
    unset _ws_lib
fi
if [ -z "$ws" ]; then
    echo "fleet-watch: cannot resolve the workspace — run setup.sh, or set WORKSPACE" >&2
    exit 1
fi

command -v python3 >/dev/null 2>&1 || {
    echo "fleet-watch: python3 not found" >&2
    exit 1
}

# Stderr is deliberately *not* folded into stdout: whatever the renderer says
# there is a failure, and a failure painted into the frame would be cleared by
# the next redraw a few seconds later. It goes to the terminal, and the caller
# below decides whether to stop.
# The size comes from `/dev/tty`, not from `tput`, because of where this is
# called from: `draw` only ever runs inside `board=$(draw)`, and inside a
# command substitution stdout is a **pipe**. `tput` measures the terminal by
# asking whatever it was pointed at, so with stdout redirected it finds no
# window and falls back to the terminfo defaults — `lines#24`, `cols#80` for
# every xterm entry. That is what a 165-column terminal was drawing an
# 80-column board into, with the tail line stranded on row 23 of 30.
#
# The give-away was that 80 is not one of *our* numbers: the fallbacks below
# are 24 and 120, so a board 80 columns wide could only have come from a
# `tput` that read terminfo successfully and measured nothing. (A `TERM` the
# host cannot look up — macOS has no `tmux-256color` entry — fails differently
# and lands on 120.)
#
# `stty size` asks the file descriptor it is given, so pointing its *stdin* at
# the tty is immune to whatever stdout happens to be. `tput` stays as the
# second answer: it is the one that still works when `LINES`/`COLUMNS` are
# exported but `/dev/tty` is not readable.
# The tab labels, re-observed. Inside `draw` rather than only in the loop so
# the one-shot path (`fleet-watch > board.txt`) gets a current map too.
#
# **Silent, unlike everything else here**, and that is the one deliberate
# exception to this script's "a person is reading, so complain" rule. The map is
# an enrichment: without it the board falls back to container names and is still
# a board. A diagnostic would print every five seconds forever, and `draw` runs
# inside `board=$(draw)` — so stdout is the frame, and anything written there
# would be painted into it. `fleet-panes.sh` never prints on any path; the
# redirect is belt and braces.
#
# It writes nothing when this terminal is not inside tmux: `list-panes -a` sees
# one tmux server, and a board with no `$TMUX` has no claim on which one — so
# writing what it saw would empty the map for every reader. That guard is in
# `fleet-panes.sh`, which is also where the launcher gets it.
#
# `bash "$panes"`, not `"$panes"`, for the reason the renderer is run through
# `python3`: no dependency on a checked-out file's exec bit.
refresh_panes() {
    [ -r "$panes" ] || return 0
    WORKSPACE="$ws" bash "$panes" >/dev/null 2>&1 || true
    return 0
}

draw() {
    local rows cols size
    refresh_panes
    size=$(stty size </dev/tty 2>/dev/null)
    rows=${size%% *}; cols=${size##* }
    case "$rows" in ''|*[!0-9]*) rows=$(tput lines 2>/dev/null) ;; esac
    case "$cols" in ''|*[!0-9]*) cols=$(tput cols 2>/dev/null) ;; esac
    case "$rows" in ''|*[!0-9]*) rows=24 ;; esac
    case "$cols" in ''|*[!0-9]*) cols=120 ;; esac

    python3 "$renderer" --data-dir "$ws/.multiplai/data" \
        --lines "$((rows - 1))" --width "$cols"
}

# Not a terminal — a pipe, a redirect, a test harness. Print the board once and
# leave. Clearing the screen and waiting on a keypress needs a tty for both
# halves, and without one the wait returns instantly, which is a busy loop
# redrawing forever rather than a board.
if [ ! -t 1 ] || [ ! -r /dev/tty ]; then
    draw
    exit $?
fi

# One restore point for the cursor, on `EXIT`, so it covers every way out —
# the loop breaking, a renderer failure, and `SIGHUP` when the window is just
# closed. A trap on `INT`/`TERM` alone leaves the cursor hidden in the user's
# shell after a closed terminal, with nothing on screen to explain it.
trap 'exit 130' INT TERM
trap 'printf "\033[?25h\n"' EXIT
printf '\033[?25l'   # hide the cursor; the trap puts it back

while :; do
    # Draw before clearing, so a renderer that dies leaves its diagnostic on
    # screen instead of being wiped by the frame that was meant to replace it.
    if ! board=$(draw); then
        echo "fleet-watch: the renderer failed (see above)" >&2
        exit 1
    fi
    printf '\033[H\033[2J%s' "$board"   # home, clear, draw
    # `-n 1` because the documented behaviour is *any key*: a bare `read` waits
    # for a newline, so the board would sit there until you pressed Enter.
    # `-s` keeps that keystroke from echoing into the frame just painted.
    read -rsn1 -t "$interval" _ </dev/tty && break
done
