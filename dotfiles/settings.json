{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "16384",
    "BASH_DEFAULT_TIMEOUT_MS": "30000",
    "BASH_MAX_OUTPUT_LENGTH": "150000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "100000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "90"
  },
  "permissions": {
    "allowedTools": [
      "Read",
      "Bash(git *)",
      "Bash(gh *)",
      "WebSearch"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gh auth setup-git 2>>$CLAUDE_MULTIPLAI_HOME/runtime/logs/hook-errors.log || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_CONFIG_DIR/hooks/validate-syntax.sh 2>>$CLAUDE_MULTIPLAI_HOME/runtime/logs/hook-errors.log"
          }
        ]
      }
    ]
  },
  "disableAllHooks": false,
  "statusLine": {
    "type": "command",
    "command": "bash $CLAUDE_CONFIG_DIR/scripts/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "multiplai-context@multiplai": true,
    "typescript-lsp@claude-plugins-official": true,
    "multiplai-dev@multiplai": true,
    "multiplai-media@multiplai": true,
    "multiplai-pm@multiplai": true,
    "multiplai-research@multiplai": true,
    "multiplai-writing@multiplai": true
  },
  "extraKnownMarketplaces": {
    "multiplai": {
      "source": {
        "source": "github",
        "repo": "spikelab/multiplai-cc-mktplace"
      },
      "autoUpdate": true
    }
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "pluginConfigs": {
    "multiplai-context@multiplai": {
      "options": {
        "workspace_dir": "/Users/spike/Documents/knowhere",
        "enable_skills": true,
        "skills_dir": "/Users/spike/.multiplai-runtimes/default/dotfiles/skills",
        "enable_resources": true,
        "resources_dir": "/Users/spike/Documents/knowhere/RESOURCES",
        "memory_router": "llm",
        "router_model": "claude-haiku-4-5",
        "resources_retrieval": "qmd",
        "qmd_mode": "ssh"
      }
    }
  },
  "tui": "default",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
