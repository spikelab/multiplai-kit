#!/bin/bash
# fleet-bar — print one line of the tmux fleet board.
#
# Invoked as `fleet-bar <n>` from a `#()` in `status-format[n]`, once per line
# per tick, in every attached client. At `status-interval 5` and four status
# lines that is a handful of invocations every five seconds, forever — so this
# script does almost nothing: it reads a pre-rendered cache and prints line n.
#
# Regeneration happens here rather than on a timer because tmux *is* the timer.
# When the cache goes stale, exactly one caller regenerates it and the rest
# print what is already there; a loser prints one-tick-old content, which at
# five seconds nobody can see. The lock is an atomic `mkdir` — the winner is
# whoever created the directory, which is decided by the kernel and needs no
# flock, no lockfile parsing, and no cleanup process.
#
# **It must never emit a diagnostic.** Anything on stdout lands *in the status
# bar*, so an error message would replace the board with itself. Every failure
# path prints an empty line and exits 0: no workspace, no cache, no renderer,
# no python. The board simply isn't there, which is the correct degradation for
# a thing whose whole job is to be glanceable.

# A line number, or nothing to say.
line="${1:-}"
case "$line" in
    ''|*[!0-9]*) echo ""; exit 0 ;;
esac

# Same resolution order as `statusline.sh` and `fleet-viewed.sh`: the
# environment first, then the marker file the kit writes at setup. tmux runs
# `#()` through the *server's* environment, which predates any launcher, so the
# file fallback is the path that fires in practice.
ws="${WORKSPACE:-}"
if [ -z "$ws" ] && [ -r "${CLAUDE_CONFIG_DIR:-}/.workspace" ]; then
    read -r ws < "$CLAUDE_CONFIG_DIR/.workspace"
fi
if [ -z "$ws" ]; then echo ""; exit 0; fi

data_dir="$ws/.multiplai/data"
cache="$data_dir/tmux/bar.txt"
lock="$data_dir/tmux/bar.lock"
renderer="$(dirname "$0")/fleet-bar-render.py"

# How long a rendered bar is reused. Matched to the `status-interval 5` the
# docs recommend: shorter would re-render several times per visible tick for no
# gain, longer would make the ages on the bar lag its own refresh.
TTL="${FLEET_BAR_TTL:-5}"

_stale() {
    [ -f "$cache" ] || return 0
    # `find -newermt` is the portable way to ask "modified within N seconds"
    # without a `stat` whose flags differ between BSD and GNU.
    [ -z "$(find "$cache" -newermt "-${TTL} seconds" 2>/dev/null)" ]
}

# A lock left behind by a killed renderer would freeze the board at whatever it
# last showed, forever, with no error anywhere — the worst failure this script
# has. A minute is far longer than a render takes and short enough that a
# stall is a blip.
find "$lock" -maxdepth 0 -type d ! -newermt "-60 seconds" -exec rmdir {} + 2>/dev/null

if _stale && mkdir "$lock" 2>/dev/null; then
    # How many rows the board owns: everything tmux is showing except line 0,
    # which stays the user's own status line. `status` is `on`/`off`/2..5.
    lines="${FLEET_BAR_LINES:-}"
    if [ -z "$lines" ]; then
        status=$(tmux show-options -gv status 2>/dev/null)
        case "$status" in
            [2-5]) lines=$((status - 1)) ;;
            *)     lines=3 ;;
        esac
    fi
    width="${FLEET_BAR_WIDTH:-}"
    if [ -z "$width" ]; then
        width=$(tmux display-message -p '#{client_width}' 2>/dev/null)
        case "$width" in
            ''|*[!0-9]*) width=120 ;;
        esac
    fi
    # Stdlib-only, host-side, reads data files. Never `uv run`, never plugin
    # code — see the renderer's docstring for why that is a boundary and not a
    # packaging choice.
    python3 "$renderer" --data-dir "$data_dir" --lines "$lines" \
        --width "$width" --out "$cache" >/dev/null 2>&1
    rmdir "$lock" 2>/dev/null
fi

# Print line n, using only builtins — no `sed`, no `awk`, no subshell, on a
# path that runs several times a second. The readability test is not
# belt-and-braces: a redirect is opened before the shell execs anything, so
# `done < missing` would put its own error on stderr regardless of what is
# redirected after it.
if [ -r "$cache" ]; then
    n=0
    while IFS= read -r text || [ -n "$text" ]; do
        n=$((n + 1))
        if [ "$n" -eq "$line" ]; then
            printf '%s\n' "$text"
            exit 0
        fi
    done < "$cache"
fi

echo ""
exit 0
